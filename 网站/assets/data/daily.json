      "name": "夬",
      "fullName": "泽天夬",
      "tuan": "扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。"
    },
    "111111": {
      "unicode": "䷀",
      "name": "乾",
      "fullName": "乾为天",
      "tuan": "元亨，利贞。"
    },
    "000000": {
      "unicode": "䷁",
      "name": "坤",
      "fullName": "坤为地",
      "tuan": "元亨，利牝马之贞。"
    },
    "010001": {
      "unicode": "䷃",
      "name": "蒙",
      "fullName": "山水蒙",
      "tuan": "亨。匪我求童蒙，童蒙求我。"
    },
    "010111": {
      "unicode": "䷅",
      "name": "讼",
      "fullName": "天水讼",
      "tuan": "有孚窒惕，中吉，终凶。利见大人，不利涉大川。"
    },
    "010000": {
      "unicode": "䷆",
      "name": "师",
      "fullName": "地水师",
      "tuan": "贞，丈人吉，无咎。"
    },
    "000010": {
      "unicode": "䷇",
      "name": "比",
      "fullName": "水地比",
      "tuan": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。"
    },
    "000111": {
      "unicode": "䷋",
      "name": "否",
      "fullName": "天地否",
      "tuan": "否之匪人，不利君子贞，大往小来。"
    },
    "001000": {
      "unicode": "䷎",
      "name": "谦",
      "fullName": "地山谦",
      "tuan": "亨，君子有终。"
    },
    "000100": {
      "unicode": "䷏",
      "name": "豫",
      "fullName": "雷地豫",
      "tuan": "利建侯行师。"
    },
    "011001": {
      "unicode": "䷑",
      "name": "蛊",
      "fullName": "山风蛊",
      "tuan": "元亨，利涉大川。先甲三日，后甲三日。"
    },
    "000011": {
      "unicode": "䷓",
      "name": "观",
      "fullName": "风地观",
      "tuan": "盥而不荐，有孚颙若。"
    },
    "000001": {
      "unicode": "䷖",
      "name": "剥",
      "fullName": "山地剥",
      "tuan": "不利有攸往。"
    },
    "011110": {
      "unicode": "䷛",
      "name": "大过",
      "fullName": "泽风大过",
      "tuan": "栋桡。利有攸往，亨。"
    },
    "010010": {
      "unicode": "䷜",
      "name": "坎",
      "fullName": "坎为水",
      "tuan": "习坎，有孚，维心亨，行有尚。"
    },
    "001110": {
      "unicode": "䷞",
      "name": "咸",
      "fullName": "泽山咸",
      "tuan": "亨，利贞。取女吉。"
    },
    "011100": {
      "unicode": "䷟",
      "name": "恒",
      "fullName": "雷风恒",
      "tuan": "亨，无咎，利贞。利有攸往。"
    },
    "001111": {
      "unicode": "䷠",
      "name": "遁",
      "fullName": "天山遁",
      "tuan": "亨。小利贞。"
    },
    "000101": {
      "unicode": "䷢",
      "name": "晋",
      "fullName": "火地晋",
      "tuan": "康侯用锡马蕃庶，昼日三接。"
    },
    "001010": {
      "unicode": "䷦",
      "name": "蹇",
      "fullName": "水山蹇",
      "tuan": "利西南，不利东北。利见大人，贞吉。"
    },
    "010100": {
      "unicode": "䷧",
      "name": "解",
      "fullName": "雷水解",
      "tuan": "利西南。无所往，其来复吉。有攸往，夙吉。"
    },
    "011111": {
      "unicode": "䷫",
      "name": "姤",
      "fullName": "天风姤",
      "tuan": "女壮，勿用取女。"
    },
    "000110": {
      "unicode": "䷬",
      "name": "萃",
      "fullName": "泽地萃",
      "tuan": "亨。王假有庙，利见大人，亨，利贞。用大牲吉，利有攸往。"
    },
    "011000": {
      "unicode": "䷭",
      "name": "升",
      "fullName": "地风升",
      "tuan": "元亨。用见大人，勿恤，南征吉。"
    },
    "010110": {
      "unicode": "䷮",
      "name": "困",
      "fullName": "泽水困",
      "tuan": "亨，贞，大人吉，无咎。有言不信。"
    },
    "011010": {
      "unicode": "䷯",
      "name": "井",
      "fullName": "水风井",
      "tuan": "改邑不改井，无丧无得，往来井井。汔至亦未繘井，羸其瓶，凶。"
    },
    "011101": {
      "unicode": "䷱",
      "name": "鼎",
      "fullName": "火风鼎",
      "tuan": "元吉，亨。"
    },
    "001001": {
      "unicode": "䷳",
      "name": "艮",
      "fullName": "艮为山",
      "tuan": "艮其背，不获其身。行其庭，不见其人。无咎。"
    },
    "001011": {
      "unicode": "䷴",
      "name": "渐",
      "fullName": "风山渐",
      "tuan": "女归吉，利贞。"
    },
    "001101": {
      "unicode": "䷷",
      "name": "旅",
      "fullName": "火山旅",
      "tuan": "小亨。旅贞吉。"
    },
    "011011": {
      "unicode": "䷸",
      "name": "巽",
      "fullName": "巽为风",
      "tuan": "小亨。利有攸往，利见大人。"
    },
    "010011": {
      "unicode": "䷺",
      "name": "涣",
      "fullName": "风水涣",
      "tuan": "亨。王假有庙，利涉大川，利贞。"
    },
    "001100": {
      "unicode": "䷽",
      "name": "小过",
      "fullName": "雷山小过",
      "tuan": "亨，利贞。可小事，不可大事。飞鸟遗之音，不宜上，宜下，大吉。"
    },
    "010101": {
      "unicode": "䷿",
      "name": "未济",
      "fullName": "火水未济",
      "tuan": "亨。小狐汔济，濡其尾，无攸利。"
    }
  }
}
