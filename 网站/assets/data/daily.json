{
  "gua": [
    {
      "id": 1,
      "unicode": "䷀",
      "name": "乾",
      "fullName": "乾为天",
      "tuan": "元亨，利贞。"
    },
    {
      "id": 2,
      "unicode": "䷁",
      "name": "坤",
      "fullName": "坤为地",
      "tuan": "元亨，利牝马之贞。"
    },
    {
      "id": 3,
      "unicode": "䷂",
      "name": "屯",
      "fullName": "水雷屯",
      "tuan": "元亨，利贞。勿用有攸往，利建侯。"
    },
    {
      "id": 4,
      "unicode": "䷃",
      "name": "蒙",
      "fullName": "山水蒙",
      "tuan": "亨。匪我求童蒙，童蒙求我。"
    },
    {
      "id": 5,
      "unicode": "䷄",
      "name": "需",
      "fullName": "水天需",
      "tuan": "有孚，光亨，贞吉。利涉大川。"
    },
    {
      "id": 6,
      "unicode": "䷅",
      "name": "讼",
      "fullName": "天水讼",
      "tuan": "有孚窒惕，中吉，终凶。利见大人，不利涉大川。"
    },
    {
      "id": 7,
      "unicode": "䷆",
      "name": "师",
      "fullName": "地水师",
      "tuan": "贞，丈人吉，无咎。"
    },
    {
      "id": 8,
      "unicode": "䷇",
      "name": "比",
      "fullName": "水地比",
      "tuan": "吉。原筮，元永贞，无咎。不宁方来，后夫凶。"
    },
    {
      "id": 9,
      "unicode": "䷈",
      "name": "小畜",
      "fullName": "风天小畜",
      "tuan": "亨。密云不雨，自我西郊。"
    },
    {
      "id": 10,
      "unicode": "䷉",
      "name": "履",
      "fullName": "天泽履",
      "tuan": "履虎尾，不咥人，亨。"
    },
    {
      "id": 11,
      "unicode": "䷊",
      "name": "泰",
      "fullName": "地天泰",
      "tuan": "小往大来，吉亨。"
    },
    {
      "id": 12,
      "unicode": "䷋",
      "name": "否",
      "fullName": "天地否",
      "tuan": "否之匪人，不利君子贞，大往小来。"
    },
    {
      "id": 13,
      "unicode": "䷌",
      "name": "同人",
      "fullName": "天火同人",
      "tuan": "同人于野，亨。利涉大川，利君子贞。"
    },
    {
      "id": 14,
      "unicode": "䷍",
      "name": "大有",
      "fullName": "火天大有",
      "tuan": "元亨。"
    },
    {
      "id": 15,
      "unicode": "䷎",
      "name": "谦",
      "fullName": "地山谦",
      "tuan": "亨，君子有终。"
    },
    {
      "id": 16,
      "unicode": "䷏",
      "name": "豫",
      "fullName": "雷地豫",
      "tuan": "利建侯行师。"
    },
    {
      "id": 17,
      "unicode": "䷐",
      "name": "随",
      "fullName": "泽雷随",
      "tuan": "元亨，利贞，无咎。"
    },
    {
      "id": 18,
      "unicode": "䷑",
      "name": "蛊",
      "fullName": "山风蛊",
      "tuan": "元亨，利涉大川。先甲三日，后甲三日。"
    },
    {
      "id": 19,
      "unicode": "䷒",
      "name": "临",
      "fullName": "地泽临",
      "tuan": "元亨，利贞。至于八月有凶。"
    },
    {
      "id": 20,
      "unicode": "䷓",
      "name": "观",
      "fullName": "风地观",
      "tuan": "盥而不荐，有孚颙若。"
    },
    {
      "id": 21,
      "unicode": "䷔",
      "name": "噬嗑",
      "fullName": "火雷噬嗑",
      "tuan": "亨。利用狱。"
    },
    {
      "id": 22,
      "unicode": "䷕",
      "name": "贲",
      "fullName": "山火贲",
      "tuan": "亨。小利有攸往。"
    },
    {
      "id": 23,
      "unicode": "䷖",
      "name": "剥",
      "fullName": "山地剥",
      "tuan": "不利有攸往。"
    },
    {
      "id": 24,
      "unicode": "䷗",
      "name": "复",
      "fullName": "地雷复",
      "tuan": "亨。出入无疾，朋来无咎。反复其道，七日来复，利有攸往。"
    },
    {
      "id": 25,
      "unicode": "䷘",
      "name": "无妄",
      "fullName": "天雷无妄",
      "tuan": "元亨，利贞。其匪正有眚，不利有攸往。"
    },
    {
      "id": 26,
      "unicode": "䷙",
      "name": "大畜",
      "fullName": "山天大畜",
      "tuan": "利贞。不家食吉，利涉大川。"
    },
    {
      "id": 27,
      "unicode": "䷚",
      "name": "颐",
      "fullName": "山雷颐",
      "tuan": "贞吉。观颐，自求口实。"
    },
    {
      "id": 28,
      "unicode": "䷛",
      "name": "大过",
      "fullName": "泽风大过",
      "tuan": "栋桡。利有攸往，亨。"
    },
    {
      "id": 29,
      "unicode": "䷜",
      "name": "坎",
      "fullName": "坎为水",
      "tuan": "习坎，有孚，维心亨，行有尚。"
    },
    {
      "id": 30,
      "unicode": "䷝",
      "name": "离",
      "fullName": "离为火",
      "tuan": "利贞，亨。畜牝牛，吉。"
    },
    {
      "id": 31,
      "unicode": "䷞",
      "name": "咸",
      "fullName": "泽山咸",
      "tuan": "亨，利贞。取女吉。"
    },
    {
      "id": 32,
      "unicode": "䷟",
      "name": "恒",
      "fullName": "雷风恒",
      "tuan": "亨，无咎，利贞。利有攸往。"
    },
    {
      "id": 33,
      "unicode": "䷠",
      "name": "遁",
      "fullName": "天山遁",
      "tuan": "亨。小利贞。"
    },
    {
      "id": 34,
      "unicode": "䷡",
      "name": "大壮",
      "fullName": "雷天大壮",
      "tuan": "利贞。"
    },
    {
      "id": 35,
      "unicode": "䷢",
      "name": "晋",
      "fullName": "火地晋",
      "tuan": "康侯用锡马蕃庶，昼日三接。"
    },
    {
      "id": 36,
      "unicode": "䷣",
      "name": "明夷",
      "fullName": "地火明夷",
      "tuan": "利艰贞。"
    },
    {
      "id": 37,
      "unicode": "䷤",
      "name": "家人",
      "fullName": "风火家人",
      "tuan": "利女贞。"
    },
    {
      "id": 38,
      "unicode": "䷥",
      "name": "睽",
      "fullName": "火泽睽",
      "tuan": "小事吉。"
    },
    {
      "id": 39,
      "unicode": "䷦",
      "name": "蹇",
      "fullName": "水山蹇",
      "tuan": "利西南，不利东北。利见大人，贞吉。"
    },
    {
      "id": 40,
      "unicode": "䷧",
      "name": "解",
      "fullName": "雷水解",
      "tuan": "利西南。无所往，其来复吉。有攸往，夙吉。"
    },
    {
      "id": 41,
      "unicode": "䷨",
      "name": "损",
      "fullName": "山泽损",
      "tuan": "有孚，元吉，无咎，可贞，利有攸往。曷之用？二簋可用享。"
    },
    {
      "id": 42,
      "unicode": "䷩",
      "name": "益",
      "fullName": "风雷益",
      "tuan": "利有攸往，利涉大川。"
    },
    {
      "id": 43,
      "unicode": "䷪",
      "name": "夬",
      "fullName": "泽天夬",
      "tuan": "扬于王庭，孚号有厉。告自邑，不利即戎，利有攸往。"
    },
    {
      "id": 44,
      "unicode": "䷫",
      "name": "姤",
      "fullName": "天风姤",
      "tuan": "女壮，勿用取女。"
    },
    {
      "id": 45,
      "unicode": "䷬",
      "name": "萃",
      "fullName": "泽地萃",
      "tuan": "亨。王假有庙，利见大人，亨，利贞。用大牲吉，利有攸往。"
    },
    {
      "id": 46,
      "unicode": "䷭",
      "name": "升",
      "fullName": "地风升",
      "tuan": "元亨。用见大人，勿恤，南征吉。"
    },
    {
      "id": 47,
      "unicode": "䷮",
      "name": "困",
      "fullName": "泽水困",
      "tuan": "亨，贞，大人吉，无咎。有言不信。"
    },
    {
      "id": 48,
      "unicode": "䷯",
      "name": "井",
      "fullName": "水风井",
      "tuan": "改邑不改井，无丧无得，往来井井。汔至亦未繘井，羸其瓶，凶。"
    },
    {
      "id": 49,
      "unicode": "䷰",
      "name": "革",
      "fullName": "泽火革",
      "tuan": "巳日乃孚。元亨，利贞，悔亡。"
    },
    {
      "id": 50,
      "unicode": "䷱",
      "name": "鼎",
      "fullName": "火风鼎",
      "tuan": "元吉，亨。"
    },
    {
      "id": 51,
      "unicode": "䷲",
      "name": "震",
      "fullName": "震为雷",
      "tuan": "亨。震来虩虩，笑言哑哑。震惊百里，不丧匕鬯。"
    },
    {
      "id": 52,
      "unicode": "䷳",
      "name": "艮",
      "fullName": "艮为山",
      "tuan": "艮其背，不获其身。行其庭，不见其人。无咎。"
    },
    {
      "id": 53,
      "unicode": "䷴",
      "name": "渐",
      "fullName": "风山渐",
      "tuan": "女归吉，利贞。"
    },
    {
      "id": 54,
      "unicode": "䷵",
      "name": "归妹",
      "fullName": "雷泽归妹",
      "tuan": "征凶，无攸利。"
    },
    {
      "id": 55,
      "unicode": "䷶",
      "name": "丰",
      "fullName": "雷火丰",
      "tuan": "亨。王假之，勿忧，宜日中。"
    },
    {
      "id": 56,
      "unicode": "䷷",
      "name": "旅",
      "fullName": "火山旅",
      "tuan": "小亨。旅贞吉。"
    },
    {
      "id": 57,
      "unicode": "䷸",
      "name": "巽",
      "fullName": "巽为风",
      "tuan": "小亨。利有攸往，利见大人。"
    },
    {
      "id": 58,
      "unicode": "䷹",
      "name": "兑",
      "fullName": "兑为泽",
      "tuan": "亨，利贞。"
    },
    {
      "id": 59,
      "unicode": "䷺",
      "name": "涣",
      "fullName": "风水涣",
      "tuan": "亨。王假有庙，利涉大川，利贞。"
    },
    {
      "id": 60,
      "unicode": "䷻",
      "name": "节",
      "fullName": "水泽节",
      "tuan": "亨。苦节，不可贞。"
    },
    {
      "id": 61,
      "unicode": "䷼",
      "name": "中孚",
      "fullName": "风泽中孚",
      "tuan": "豚鱼吉。利涉大川，利贞。"
    },
    {
      "id": 62,
      "unicode": "䷽",
      "name": "小过",
      "fullName": "雷山小过",
      "tuan": "亨，利贞。可小事，不可大事。飞鸟遗之音，不宜上，宜下，大吉。"
    },
    {
      "id": 63,
      "unicode": "䷾",
      "name": "既济",
      "fullName": "水火既济",
      "tuan": "亨小，利贞。初吉终乱。"
    },
    {
      "id": 64,
      "unicode": "䷿",
      "name": "未济",
      "fullName": "火水未济",
      "tuan": "亨。小狐汔济，濡其尾，无攸利。"
    }
  ],
  "astro": [
    {
      "text": "斗为帝车，运于中央，临制四乡。分阴阳，建四时，均五行，移节度，定诸纪，皆系于斗。",
      "source": "《史记·天官书》"
    },
    {
      "text": "中宫天极星，其一明者，太一常居也。",
      "source": "《史记·天官书》"
    },
    {
      "text": "天则有日月，地则有阴阳。天有五星，地有五行。天则有列宿，地则有州域。",
      "source": "《史记·天官书》"
    },
    {
      "text": "太史公曰：自初生民以来，世主曷尝不历日月星辰？",
      "source": "《史记·天官书》"
    },
    {
      "text": "海旁蜃气象楼台，广野气成宫阙然。云气各象其山川人民所聚积。",
      "source": "《汉书·天文志》"
    },
    {
      "text": "日有中道，月有九行。中道者，黄道，一曰光道。",
      "source": "《汉书·天文志》"
    },
    {
      "text": "凡天文在图籍昭昭可知者，经星常宿中外官凡百一十八名，积数七百八十三星。",
      "source": "《汉书·天文志》"
    },
    {
      "text": "五星若合，是谓易行。有德受庆，改立王者，奄有四方，子孙蕃昌。",
      "source": "《汉书·天文志》"
    },
    {
      "text": "赤乌十一年夏四月，雨雹。云阳言黄龙现。",
      "source": "《三国志·吴主传》"
    },
    {
      "text": "夏四月，夏口、武昌并言黄龙、凤凰见。",
      "source": "《三国志·吴主传》"
    },
    {
      "text": "青龙元年春正月甲申，青龙见摩陂井中。",
      "source": "《三国志·魏书·明帝纪》"
    }
  ],
